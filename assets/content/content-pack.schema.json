{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-python.local/schemas/content-pack-v1.json",
  "title": "Easy Python versioned content pack",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "language", "tasks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "language": {"type": "string", "minLength": 2},
    "course": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "minutes", "overview", "lesson", "examples", "practicals", "project"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "minutes": {"type": "integer", "minimum": 1},
          "overview": {"type": "string", "minLength": 1},
          "lesson": {"type": "array", "items": {"$ref": "#/$defs/section"}},
          "examples": {"type": "array", "items": {"$ref": "#/$defs/example"}},
          "practicals": {"type": "array", "items": {"$ref": "#/$defs/practical"}},
          "project": {"$ref": "#/$defs/project"}
        }
      }
    }
  },
  "$defs": {
    "section": {"type": "object", "required": ["heading", "body"], "properties": {"heading": {"type": "string"}, "body": {"type": "string"}}},
    "example": {"type": "object", "required": ["title", "code", "output", "explanation"], "properties": {"title": {"type": "string"}, "code": {"type": "string"}, "output": {"type": "string"}, "explanation": {"type": "string"}}},
    "practical": {"type": "object", "required": ["id", "type", "prompt"], "properties": {"id": {"type": "string"}, "type": {"enum": ["yesNo", "multipleChoice", "code", "fixTheBug", "shortAnswer"]}, "prompt": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}, "answer": {"type": "string"}, "requiredKeywords": {"type": "array", "items": {"type": "string"}}, "tests": {"type": "array"}}},
    "project": {"type": "object", "required": ["title", "scenario", "friendPrompt", "steps", "tests"], "properties": {"title": {"type": "string"}, "scenario": {"type": "string"}, "friendPrompt": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}}, "tests": {"type": "array"}}}
  }
}
